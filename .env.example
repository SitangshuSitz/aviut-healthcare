# Database (Postgres; tables are created automatically by `prisma migrate deploy` on start)
# e.g. a free connection string from https://neon.tech or https://supabase.com
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# NextAuth
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys)
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"
RAZORPAY_WEBHOOK_SECRET="xxxxxxxxxxxxxxxxxxxxxxxx"

# Exposed to the browser for Razorpay Checkout
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxx"

# Pricing (in paise: 1 INR = 100 paise)
EMPLOYER_PLAN_AMOUNT_PAISE=99900
GOLD_PLAN_AMOUNT_PAISE=29900
